<%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-gray-100">

  <%- include('../partials/header') %>
  <!--  Box -->
  <main class="flex justify-center items-start min-h-screen bg-gray-100 px-4 pt-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 w-full max-w-7xl">
      <% registeredHouse.forEach(home => { %>
        <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden">
          
          <!-- Image Container with Relative Position -->
          <div class="relative">
            <img 
              src="/Home.jpg" 
              alt="Home Image" 
              class="w-full h-52 object-cover"
            />
            <!-- Rating Badge -->
            <div class="absolute top-2 right-2 bg-rose-100 text-rose-700 text-sm font-semibold px-3 py-1 rounded-full shadow-sm border border-rose-200">
              ⭐ <%= home.rating %>
            </div>
          </div>

          <div class="p-5 space-y-2">
            <h3 class="text-lg font-bold text-gray-800 truncate">
              🏠 <%= home.houseName %>
            </h3>
            <p class="text-sm text-gray-600"><span class="font-medium">📍 Location:</span> <%= home.location %></p>
            <p class="text-sm text-gray-600"><span class="font-medium">💰 Price:</span> ₹<%= home.price %>/night</p>
<!-- Book Now & Details Buttons (Side by Side, Small) -->
<div class="pt-3 flex space-x-2">
  <!-- Book Now -->
  <a 
    href="/book/<%= home._id %>" 
    class="flex-1 text-center bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-1.5 px-3 rounded-md transition duration-300"
  >
    Book
  </a>

  <!-- View Details -->
  <a 
    href="/details/<%= home._id %>" 
    class="flex-1 text-center bg-gray-200 hover:bg-gray-300 text-gray-800 text-sm font-medium py-1.5 px-3 rounded-md transition duration-300"
  >
    Details
  </a>
</div>



          </div>
        </div>
      <% }) %>
    </div>
  </main>

</body>
</html>
