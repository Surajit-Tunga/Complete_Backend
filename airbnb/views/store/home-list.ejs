<%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-gray-100">

  <%- include('../partials/header') %>

  <main class="flex justify-center items-start min-h-screen bg-gray-100 px-4 pt-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 w-full max-w-7xl">

      <% registeredHouse.forEach(home => { %>
        <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden">
          
          <!-- Image + Rating -->
          <div class="relative">
            <img 
              src="<%= home.photo %>" 
              alt="<%= home.houseName %>" 
              class="w-full h-52 object-cover"
            />
            <div class="absolute top-2 right-2 bg-yellow-100 text-yellow-800 text-sm font-semibold px-3 py-1 rounded-full shadow border border-yellow-300">
              ⭐ <%= home.rating %>
            </div>
          </div>

          <!-- Home Info -->
          <div class="p-5 space-y-2">
            <h3 class="text-lg font-bold text-gray-800 truncate">
              🏠 <%= home.houseName %>
            </h3>
            <p class="text-sm text-gray-600">
              📍 <span class="font-medium">Location:</span> <%= home.location %>
            </p>
            <p class="text-sm text-gray-600">
              💰 <span class="font-medium">Price:</span> ₹<%= home.price %>/night
            </p>

            <!-- Buttons -->
            <div class="pt-4 flex justify-between gap-2">
              <!-- Add to Favourites -->
              <%- include('../partials/fav', { home: home }) %>
              <!-- View Details -->
              <a 
                href="/homes/<%= home._id %>" 
                class="flex-1 text-center bg-gray-200 hover:bg-gray-300 text-gray-800 text-sm font-medium py-1.5 rounded-md transition duration-300"
              >
                ℹ️ Details
              </a>
            </div>

          </div>
        </div>
      <% }) %>

    </div>
  </main>

</body>
</html>
