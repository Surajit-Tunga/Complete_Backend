<%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-gray-100">

  <%- include('../partials/header') %>

  <!-- Main Content -->
  <main class="flex justify-center items-start min-h-screen bg-gray-100 px-4 pt-12">
    <div class="max-w-2xl w-full bg-white shadow-lg rounded-2xl overflow-hidden">
      
      <!-- Image -->
      <div class="h-64 w-full">
        <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="w-full h-full object-cover">
      </div>

      <!-- Details -->
      <div class="p-6">
        <h1 class="text-3xl font-bold text-gray-800 mb-4"><%= home.houseName %></h1>
        <div class="text-gray-600 space-y-2">
          <p><span class="font-semibold">Price:</span> $<%= home.price %></p>
          <p><span class="font-semibold">Location:</span> <%= home.location %></p>
          <p><span class="font-semibold">Rating:</span> <%= home.rating %> ⭐</p>
        </div>
        <div>
          <%- include('../partials/fav') %>
        </div>
      </div>
    </div>
  </main>

</body>
</html>
