<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Bookings</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="min-h-screen bg-gray-100">

 <%- include('../partials/header') %>

  <!-- Main Content -->
  <main class="max-w-6xl mx-auto pt-10 px-4">
    <h2 class="text-2xl font-bold mb-6 text-gray-800">📖 My Bookings</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Booking Card 1 -->
      <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition p-4 space-y-3">
        <img src="https://source.unsplash.com/400x200/?house" alt="Home" class="w-full h-40 object-cover rounded-md" />
        <div>
          <h3 class="text-lg font-semibold text-gray-800 truncate">🏠 Lakeview Cottage</h3>
          <p class="text-sm text-gray-600">📍 Shimla</p>
          <p class="text-sm text-gray-600">💰 ₹2000/night</p>
        </div>
        <div class="text-sm text-gray-700 border-t pt-2">
          <p>📅 <strong>Check-In:</strong> 2025-08-01</p>
          <p>📅 <strong>Check-Out:</strong> 2025-08-04</p>
          <p>👥 <strong>Guests:</strong> 2</p>
        </div>
        <button class="mt-3 w-full bg-red-100 text-red-700 text-sm font-semibold py-1.5 rounded-lg hover:bg-red-200">
          ❌ Cancel Booking
        </button>
      </div>

      <!-- Booking Card 2 -->
      <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition p-4 space-y-3">
        <img src="https://source.unsplash.com/400x200/?cabin" alt="Home" class="w-full h-40 object-cover rounded-md" />
        <div>
          <h3 class="text-lg font-semibold text-gray-800 truncate">🏠 Mountain Cabin</h3>
          <p class="text-sm text-gray-600">📍 Manali</p>
          <p class="text-sm text-gray-600">💰 ₹3000/night</p>
        </div>
        <div class="text-sm text-gray-700 border-t pt-2">
          <p>📅 <strong>Check-In:</strong> 2025-08-10</p>
          <p>📅 <strong>Check-Out:</strong> 2025-08-14</p>
          <p>👥 <strong>Guests:</strong> 3</p>
        </div>
        <button class="mt-3 w-full bg-red-100 text-red-700 text-sm font-semibold py-1.5 rounded-lg hover:bg-red-200">
          ❌ Cancel Booking
        </button>
      </div>
    </div>
  </main>

</body>
</html>
