<%- include('partials/head') %>
</head>
<body class="min-h-screen bg-gray-100">

  <%- include('partials/header') %>
<!--  Box -->
<main class="flex justify-center items-start min-h-screen bg-gray-100 px-4 pt-8">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 w-full max-w-7xl">
    <% registeredHouse.forEach(home => { %>
      <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden">
        <img 
          src="/Home.jpg" 
          alt="Home Image" 
          class="w-full h-52 object-cover"
        />
        <div class="p-5 space-y-2">
          <h3 class="text-lg font-bold text-gray-800 truncate">
            🏠 <%= home.houseName %>
          </h3>
          <p class="text-sm text-gray-600"><span class="font-medium">📍 Location:</span> <%= home.location %></p>
          <p class="text-sm text-gray-600"><span class="font-medium">💰 Price:</span> ₹<%= home.price %>/night</p>
          <p class="text-sm text-gray-600"><span class="font-medium">⭐ Rating:</span> <%= home.rating %>/5</p>
        </div>
      </div>
    <% }) %>
  </div>
</main>





</body>
</html>
