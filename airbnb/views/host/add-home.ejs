 <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-gray-100">

  <%- include('../partials/header') %>

  <!-- Centered Form Box -->
  <main class="flex items-center justify-center h-[80vh]">
    <div class="bg-white p-10 rounded-2xl shadow-lg w-full max-w-md">
      <p class="text-lg font-medium text-gray-700 mb-6">Please add your home.</p>
     <form action="/host/add-home" method="POST" class="space-y-4">
  <input 
    type="text" 
    name="houseName" 
    placeholder="Enter your House Name" 
    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-400"
    required
  />
  
  <input 
    type="number" 
    name="price" 
    placeholder="Enter Price per Night (INR)" 
    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-400"
    required
  />

  <input 
    type="text" 
    name="location" 
    placeholder="Enter Location" 
    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-400"
    required
  />

  <input 
    type="number" 
    name="rating" 
    step="0.1" 
    min="1" 
    max="5" 
    placeholder="Enter Rating (1 to 5)" 
    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-400"
  />

  <!-- <input 
    type="url" 
    name="photoURL" 
    placeholder="Enter Photo URL" 
    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-400"
  /> -->

  <input 
    type="submit" 
    value="Submit" 
    class="w-full bg-red-500 text-white font-semibold py-2 rounded-md hover:bg-red-600 transition"
  />
</form>

    </div>
  </main>

</body>
</html>
